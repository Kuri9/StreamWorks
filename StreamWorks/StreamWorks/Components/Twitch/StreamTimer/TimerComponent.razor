@page "/timer"
@rendermode InteractiveServer
@using StreamWorks.Helpers.Widgets.Timers
@using StreamWorks.Library.Models.Widgets.Timers
@inject ILogger<TimerComponent> Logger
@inject NavigationManager navManager
@inject IConfiguration Config
@inject IStreamWorksUserData userData
@inject AuthenticationStateProvider authProvider
@inject IStreamWorksTimerData timerConfig
@inject IStreamTimer streamTimer

<h3>@streamTimer.Timer.CurrentTime</h3>

<div class="row mb-3">
    <div class="d-grid button-connected-group">
        <Button Class="btn btn-lg btn-dark" @onclick="StartTimer">Start</Button>
        <Button Class="btn btn-lg btn-dark" @onclick="StopTimer">Stop</Button>
    </div>
</div>

@code {
    private StreamWorksUserModel loggedInUser = default!;
    private StreamTimerModel currentStreamTimer = default!;

    TimeSpan timerInterval = TimeSpan.FromMilliseconds(1000);

    private HubConnection? streamHub;

    protected override async Task OnInitializedAsync()
    {
        loggedInUser = await authProvider.GetUserFromAuth(userData);

        streamHub = new HubConnectionBuilder()
        .WithUrl(navManager.ToAbsoluteUri("/Streamhub"))
        .WithAutomaticReconnect()
        .Build();

        streamHub.On<string>("TimerTicked", (timeNow) =>
        {
            Logger.LogInformation($"In timer component!");
            onTick(timeNow);
        });

        await streamHub.StartAsync();

        // Join the Hub Group for this User
        var groupName = loggedInUser.Id.ToString();
        await streamHub.SendAsync("JoinGroup", groupName);
        Logger.LogInformation($"Joined Group: {groupName}");

        Setup();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {

        }
    }

    private async Task Setup()
    {
        var result = await GetUserTimer();
        if (result is not null)
        {
            SetTimerData(result);
        }
    }

    private void onTick(string timeNow)
    {
        // Logger.LogInformation($"Timer ticked: {timeNow}");
        streamTimer.OnTimerTicked();

        InvokeAsync(StateHasChanged);
    }

    public async Task StartTimer()
    {
        Logger.LogInformation("Starting Timer");
        streamTimer.StartTimer();
    }

    public async Task StopTimer()
    {
        streamTimer.StopTimer();
    }

    public async Task<StreamTimerModel> GetUserTimer()
    {
        if (timerConfig is not null)
        {
            try
            {
                var result = await timerConfig.GetTimerDataByUserId(loggedInUser.Id);
                currentStreamTimer = result.First();

                return currentStreamTimer;
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error getting user timer");
            }
        }

        return null;
    }

    public void SetTimerData(StreamTimerModel timerToSet)
    {
        streamTimer.SetTimerData(timerToSet);
    }

    private void Dispose()
    {
        streamHub?.DisposeAsync();
    }
}